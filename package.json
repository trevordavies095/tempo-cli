{
  "name": "tempo-cli",
  "version": "0.0.0",
  "description": "Command-line client for Tempo",
  "type": "module",
  "bin": {
    "tempo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tempo",
    "cli"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "luxon": "^3.5.0",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
